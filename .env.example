# Neon Postgres connection string (get it from https://console.neon.tech)
DATABASE_URI=postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require

# Random string used to sign JWTs / secure the admin panel. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public URL of the deployed site (used for absolute links, sitemaps, etc.)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
