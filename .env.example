# =========================================================================
# Coolify / Production Environment Variables
# =========================================================================

# 1. PostgreSQL Veritabanı Bilgileri (docker-compose db servisi için)
POSTGRES_DB=mosaik
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sifreniz_buraya

# 2. Payload CMS Veritabanı Bağlantı Dizesi (Opsiyonel: Eğer boş bırakılırsa compose otomatik postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB} oluşturur)
DATABASE_URI=postgresql://postgres:sifreniz_buraya@db:5432/mosaik

# 3. Payload CMS Güvenlik Anahtarı (Min 32 karakter)
PAYLOAD_SECRET=jNYrMbKAgyxr8LVvK2sNo12weg7XdSDp

# 4. Canlı Domain Adresi
NEXT_PUBLIC_SERVER_URL=https://mosaik-ruesselsheim.de

# 5. Coolify Docker Ağı & Port
DOCKER_NETWORK=coolify
PORT=3000

# 6. SMTP E-Posta Yapılandırması (Admin Şifre Sıfırlama & İletişim Formu İçin)
# Örnek sağlayıcılar: IONOS (smtp.ionos.de), Gmail (smtp.gmail.com), Resend (smtp.resend.com), Brevo, vb.
SMTP_HOST=smtp.your-mail-server.com
SMTP_PORT=587
SMTP_USER=info@mosaik-ruesselsheim.de
SMTP_PASS=eposta_sifreniz_veya_app_password
SMTP_SECURE=false
SMTP_FROM_ADDRESS=info@mosaik-ruesselsheim.de
SMTP_FROM_NAME="Mosaik Dialog und Kultur e.V."
SMTP_TO_ADDRESS=info@mosaik-ruesselsheim.de

# NOT: Tüm resimler ve medya dosyaları doğrudan VPS üzerindeki
# ./public/media klasöründe (kalıcı volume olarak) saklanır.
