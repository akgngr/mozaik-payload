# =========================================================================
# Coolify / Production Environment Variables
# =========================================================================

# 1. Mevcut PostgreSQL Veritabanı Bağlantınız
# Coolify'daki mevcut postgres container adını veya host'u yazın:
# Örnek: postgresql://kullanici:sifre@postgres_container_adi:5432/mosaik
DATABASE_URI=postgresql://postgres:sifreniz@localhost:5432/mosaik

# 2. Payload CMS Güvenlik Anahtarı (Min 32 karakter)
PAYLOAD_SECRET=jNYrMbKAgyxr8LVvK2sNo12weg7XdSDp

# 3. Canlı Domain Adresi
NEXT_PUBLIC_SERVER_URL=https://mosaik-ruesselsheim.de

# 4. Docker Ağı (Mevcut PostgreSQL ile aynı Coolify Docker ağı)
DOCKER_NETWORK=coolify
PORT=3000

# NOT: Tüm resimler ve medya varlıkları doğrudan VPS üzerindeki
# ./public/media klasöründe (volume olarak) saklanır.
# Cloudinary artık zorunlu değildir. İstenirse opsiyonel olarak kullanılabilir:
# USE_CLOUDINARY=false
